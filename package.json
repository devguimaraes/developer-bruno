{
  "name": "vite_react_shadcn_ts",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "biome lint .",
    "lint:fix": "biome lint . --fix",
    "format": "biome format .",
    "format:fix": "biome format . --write",
    "prepare": "husky",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "test:coverage:open": "bun run test:coverage && open-cli coverage/index.html",
    "optimize:media": "node scripts/optimize-media.mjs",
    "check:media-budget": "bun run scripts/check-media-budget.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/vercel": "^11.0.22",
    "astro": "^7.4.12",
    "clsx": "^2.1.1",
    "framer-motion": "^14.14.0",
    "gsap": "^3.15.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resend": "^6.38.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "open-cli": "^9.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "biome lint --fix",
      "biome format --write",
      "bash -c 'tsc -p tsconfig.app.json --noEmit'"
    ]
  }
}
