---
import Layout from "@/layouts/Layout.astro";
import Index from "@/components/pages/Index";
import { getCollection } from "astro:content";
import { generateSlug, convertBrazilianDate } from "@/lib/blog";
import type { BlogPost } from "@/types/blog";
import { siteConfig } from "@/config/site";
import { getAllTechnologies } from "@/data/skills";

const entries = await getCollection("blog");

const posts: BlogPost[] = entries.map(entry => ({
  id: entry.id,
  slug: generateSlug(entry.id),
  title: entry.data.title,
  date: entry.data.date,
  readTime: entry.data.readTime || "5 min",
  tags: entry.data.tags,
  author: entry.data.author,
  excerpt: entry.data.excerpt,
  content: "",
}));

posts.sort((a, b) => {
  return convertBrazilianDate(b.date).getTime() - convertBrazilianDate(a.date).getTime();
});

const latestPosts = posts.slice(0, 3);

// Schema.org structured data
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Bruno Guimarães",
  url: siteConfig.domain,
  jobTitle: "Desenvolvedor Front-End",
  description: siteConfig.description,
  image: new URL(siteConfig.avatar, siteConfig.domain).href,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Rio de Janeiro",
    addressRegion: "RJ",
    addressCountry: "BR",
  },
  knowsAbout: [...getAllTechnologies()],
  sameAs: [siteConfig.github, siteConfig.linkedin, "https://www.instagram.com/brunoguimraes/"],
  email: siteConfig.email,
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteConfig.seo.siteName,
  url: siteConfig.domain,
  description: siteConfig.description,
  inLanguage: "pt-BR",
  author: {
    "@type": "Person",
    name: siteConfig.author,
  },
  publisher: {
    "@type": "Person",
    name: siteConfig.author,
    url: siteConfig.domain,
  },
};

// Combine both schemas
const structuredData = [personSchema, webSiteSchema];
---

<Layout
  title="Bruno Guimarães | Desenvolvedor Front-End em Rio de Janeiro"
  description="Desenvolvedor Front-End especializado em React, TypeScript e interfaces modernas. Criação de sites e softwares de alta performance no Rio de Janeiro e em todo o Brasil."
  structuredData={structuredData}
>
  <Index latestPosts={latestPosts} client:load />
</Layout>
