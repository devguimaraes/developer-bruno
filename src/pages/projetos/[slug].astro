---
import Layout from "@/layouts/Layout.astro";
import CaseStudy from "@/components/projects/CaseStudy";
import { selectedWorks } from "@/data/projects";
import { getCollection, type CollectionEntry } from "astro:content";
import { siteConfig } from "@/config/site";

type BlogEntry = CollectionEntry<"blog">;

export function getStaticPaths() {
  return selectedWorks.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const blogEntries = await getCollection("blog");

// Get related blog posts: first try data-driven relatedPosts, fall back to tag-matching
let relatedBlogEntries: BlogEntry[] = [];

if (project.relatedPosts && project.relatedPosts.length > 0) {
  // Use data-driven related posts from project definition
  relatedBlogEntries = project.relatedPosts
    .map(slug => blogEntries.find(entry => entry.id === slug))
    .filter(Boolean);
} else {
  // Fall back to tag-matching algorithm
  const projectKeywords = [...project.tech, ...(project.tags || [])].map((k) =>
    k.toLowerCase(),
  );

  // Score posts by how many tags overlap with project keywords
  const scoredPosts = blogEntries
    .map((entry) => {
      const blogTags = entry.data.tags.map((t) => t.toLowerCase());
      const score = blogTags.filter((tag) =>
        projectKeywords.some((kw) => tag.includes(kw) || kw.includes(tag)),
      ).length;
      return { entry, score };
    })
    .filter(({ score }) => score > 0)
    .sort((a, b) => b.score - a.score)
    .slice(0, 2);

  relatedBlogEntries = scoredPosts.map(({ entry }) => entry);
}

const relatedPosts = relatedBlogEntries.map((entry) => ({
  id: entry.id,
  slug: entry.id,
  title: entry.data.title,
  date: entry.data.date,
  readTime: entry.data.readTime || "5 min",
  tags: entry.data.tags,
  author: entry.data.author,
  excerpt: entry.data.excerpt,
  content: "",
  image: entry.data.image,
  featured: entry.data.featured,
}));

// Structured data for the case study
const caseStudySchema = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: project.title,
  description: project.description,
  about: project.category,
  keywords: [...project.tech, ...(project.tags || [])].join(", "),
  author: {
    "@type": "Person",
    name: siteConfig.author,
    url: siteConfig.domain,
  },
  ...(project.live && {
    url: project.live,
  }),
  ...(project.role && {
    contributor: {
      "@type": "Person",
      name: siteConfig.author,
      roleName: project.role,
    },
  }),
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `${siteConfig.domain}/projetos/${project.slug}`,
  },
  inLanguage: "pt-BR",
};
---

<Layout
  title={`${project.title} — Case Study`}
  description={project.description || `Estudo de caso do projeto ${project.title}`}
  image={project.bannerImage ?? project.image}
  structuredData={caseStudySchema}
  ogType="article"
>
  <CaseStudy project={project} relatedPosts={relatedPosts} client:load />
</Layout>
