---
import Layout from '@/layouts/Layout.astro';
import AntigravityPageClient from '@/components/pages/AntigravityPage';

const structuredData = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Gemini Config Pack",
  description: "6 skills modularizadas + comandos prontos para Antigravity e Gemini CLI. Planning, React, TypeScript, Software Engineering, Code Review e Writing.",
  offers: {
    "@type": "Offer",
    price: "47.00",
    priceCurrency: "BRL",
    availability: "https://schema.org/InStock",
    seller: {
      "@type": "Person",
      name: "Bruno Guimarães",
    },
  },
};
---

<Layout 
  title="Gemini Config Pack | 6 Skills + Comandos para Antigravity e Gemini CLI"
  description="6 skills modularizadas (React, TypeScript, Planning...) + comandos prontos para Antigravity e Gemini CLI. Melhore seu código com padrões de engenharia."
  structuredData={structuredData}
>
  <AntigravityPageClient client:load />
</Layout>
