---
import Layout from "@/layouts/Layout.astro";
import BlogPostPageClient from "@/components/pages/BlogPostPage";
import { getCollection, render } from "astro:content";
import { generateSlug, toISODate, convertBrazilianDate } from "@/lib/blog";
import type { BlogPost } from "@/types/blog";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  const sortedEntries = [...entries].sort(
    (a, b) =>
      convertBrazilianDate(b.data.date).getTime() - convertBrazilianDate(a.data.date).getTime()
  );

  // Render all entries in parallel first
  const renderedEntries = await Promise.all(
    sortedEntries.map(async entry => ({
      entry,
      rendered: await render(entry),
    }))
  );

  const toBlogPost = (entry: (typeof entries)[number]): BlogPost => ({
    id: entry.id,
    slug: generateSlug(entry.id),
    title: entry.data.title,
    date: entry.data.date,
    readTime: entry.data.readTime || "5 min",
    tags: entry.data.tags,
    author: entry.data.author,
    excerpt: entry.data.excerpt,
    content: entry.body || "",
    image: entry.data.image,
    featured: entry.data.featured,
  });

  return renderedEntries.map(({ entry, rendered: { Content, headings } }, index) => ({
    params: { slug: generateSlug(entry.id) },
    props: {
      post: toBlogPost(entry),
      previous: index > 0 ? toBlogPost(sortedEntries[index - 1]) : null,
      next: index < sortedEntries.length - 1 ? toBlogPost(sortedEntries[index + 1]) : null,
      Content,
      headings,
    },
  }));
}

const { post, previous, next, Content, headings } = Astro.props;
const structuredDataImage = post.image
  ? post.image.startsWith("http://") || post.image.startsWith("https://")
    ? post.image
    : `https://devguimaraes.com.br${post.image}`
  : "https://devguimaraes.com.br/og-image.webp";
---

<Layout
  title={post.title}
  description={post.excerpt}
  ogType="article"
  articlePublishedTime={toISODate(post.date)}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title,
    description: post.excerpt,
    author: {
      '@type': 'Person',
      name: post.author,
      url: 'https://devguimaraes.com.br',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Bruno Guimarães',
      url: 'https://devguimaraes.com.br',
      logo: {
        '@type': 'ImageObject',
        url: 'https://devguimaraes.com.br/logo.webp',
      },
    },
    datePublished: toISODate(post.date),
    dateModified: toISODate(post.date),
    mainEntityOfPage: {
      '@type': 'WebPage',
      '@id': `https://devguimaraes.com.br/blog/${post.slug}`,
    },
    image: structuredDataImage,
    inLanguage: 'pt-BR',
    articleSection: post.tags?.[0] || 'Desenvolvimento Web',
    keywords: post.tags?.join(', '),
  }}
>
  <BlogPostPageClient
    post={post}
    previous={previous}
    next={next}
    headings={headings}
    client:load
  >
    <Content />
  </BlogPostPageClient>
</Layout>
