---
import { getCollection, render } from "astro:content";
import BlogPostPageClient from "@/components/pages/BlogPostPage";
import Layout from "@/layouts/Layout.astro";
import { convertBrazilianDate, generateSlug, toISODate } from "@/lib/blog";
import { t } from "@/lib/i18n";
import type { BlogPost } from "@/types/blog";
import "@/styles/giro-post.css";

export async function getStaticPaths() {
  const entries = await getCollection("blog");
  const sortedEntries = [...entries].sort(
    (a, b) =>
      convertBrazilianDate(b.data.date).getTime() - convertBrazilianDate(a.data.date).getTime()
  );

  // Render all entries in parallel first
  const renderedEntries = await Promise.all(
    sortedEntries.map(async entry => ({
      entry,
      rendered: await render(entry),
    }))
  );

  const toBlogPost = (entry: (typeof entries)[number]): BlogPost => ({
    id: entry.id,
    slug: generateSlug(entry.id),
    title: entry.data.title,
    date: entry.data.date,
    readTime: entry.data.readTime || "5 min",
    tags: entry.data.tags,
    author: entry.data.author,
    excerpt: entry.data.excerpt,
    content: entry.body || "",
    image: entry.data.image,
    featured: entry.data.featured,
  });

  return renderedEntries.map(({ entry, rendered: { Content } }, index) => ({
    params: { slug: generateSlug(entry.id) },
    props: {
      post: toBlogPost(entry),
      following: sortedEntries.slice(index + 1, index + 3).map(item => toBlogPost(item)),
      Content,
    },
  }));
}

const { post, following, Content } = Astro.props;
---

<Layout
  title={t("pt", "meta.post_title", { title: post.title })}
  description={post.excerpt}
  ogType="article"
  articlePublishedTime={toISODate(post.date)}
>
  <BlogPostPageClient post={post} following={following} client:load>
    <Content />
  </BlogPostPageClient>
</Layout>
