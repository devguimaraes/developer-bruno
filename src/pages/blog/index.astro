---
import Layout from '@/layouts/Layout.astro';
import BlogPageClient from '@/components/pages/BlogPage';
import { getAllBlogPosts } from '@/lib/blog';

// Fetch data at build time (SSG)
const posts = await getAllBlogPosts();
---

<Layout 
  title="Blog de Desenvolvimento Web" 
  description="Artigos sobre React, Next.js e engenharia front-end por Bruno Guimarães."
>
  <!-- Pass the pre-fetched posts as initialData to avoid client-side waterfalls, but keep React interactivity -->
  <BlogPageClient initialPosts={posts} client:load />
</Layout>
