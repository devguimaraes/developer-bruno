---
import Layout from '@/layouts/Layout.astro';
import BlogPageClient from '@/components/pages/BlogPage';
import { getCollection } from 'astro:content';
import { parseReadingTime } from '@/lib/blog/content';
import { generateSlug, toISODate } from '@/lib/blog';
import type { BlogPost } from '@/types/blog';

const entries = await getCollection('blog');

const months: Record<string, number> = {
  JAN: 0, FEV: 1, MAR: 2, ABR: 3, MAI: 4, JUN: 5,
  JUL: 6, AGO: 7, SET: 8, OUT: 9, NOV: 10, DEZ: 11,
};

const posts: BlogPost[] = entries.map((entry) => ({
  id: entry.id,
  slug: generateSlug(entry.id),
  title: entry.data.title,
  date: entry.data.date,
  readTime: entry.data.readTime || '5 min',
  readingTime: parseReadingTime(entry.data.readTime),
  tags: entry.data.tags,
  author: entry.data.author,
  excerpt: entry.data.excerpt,
  content: '',
  image: entry.data.image,
  featured: entry.data.featured,
}));

posts.sort((a, b) => {
  const parseDate = (d: string) => {
    const parts = d.split(' ');
    if (parts.length === 3) return new Date(Number(parts[2]), months[parts[1].toUpperCase()] ?? 0, Number(parts[0]));
    return new Date(d);
  };
  return parseDate(b.date).getTime() - parseDate(a.date).getTime();
});
---

<Layout
  title="Blog - Bruno Guimarães | Desenvolvedor Front-End Brasil"
  description="Blog sobre desenvolvimento web com artigos sobre React, Next.js, TypeScript, engenharia front-end e melhores práticas. Aprenda com um desenvolvedor brasileiro."
  ogType="blog"
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: 'Blog — Bruno Guimarães',
    description: 'Artigos sobre React, Next.js, TypeScript e engenharia front-end.',
    url: 'https://devguimaraes.com.br/blog',
    inLanguage: 'pt-BR',
    author: {
      '@type': 'Person',
      name: 'Bruno Guimarães',
      url: 'https://devguimaraes.com.br',
    },
    publisher: {
      '@type': 'Organization',
      name: 'Bruno Guimarães',
      url: 'https://devguimaraes.com.br',
    },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      headline: post.title,
      url: `https://devguimaraes.com.br/blog/${post.slug}`,
      datePublished: toISODate(post.date),
      description: post.excerpt,
      author: {
        '@type': 'Person',
        name: post.author,
      },
    })),
  }}
>
  <BlogPageClient initialPosts={posts} client:load />
</Layout>
