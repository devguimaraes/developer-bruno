---
// src/layouts/Layout.astro
import "@/index.css";
import "@/styles/markdown.css";
import { siteConfig } from "@/config/site";
import { t } from "@/lib/i18n";
import { ClientRouter } from "astro:transitions";

import { SiteHeader } from "@/components/nav/SiteHeader";
import { SiteFooter } from "@/components/nav/SiteFooter";
import { ScrollIsland } from "@/components/nav/ScrollIsland";
import { TabBar } from "@/components/nav/TabBar";
import { LoadingScreen } from "@/components/loader/LoadingScreen";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  ogType?: string;
  noindex?: boolean;
  articlePublishedTime?: string;
}

const { title, description, image, ogType, noindex = false, articlePublishedTime } = Astro.props;

// Meta values with fallbacks. A página passa o título completo, sem sufixo da marca.
const finalTitle = title || t("pt", "meta.home_title");
const finalDesc = description || siteConfig.description;
const usesDefaultImage = !image;
const finalImage = image ? new URL(image, Astro.url) : new URL(siteConfig.seo.image, Astro.url);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Tela de carregamento: liga o overlay só na primeira visita da sessão, antes do primeiro paint.
         is:inline para o Astro não empacotar nem adiar o script. Sem JS, nada é ligado. O backstop
         tira o overlay se o React não montar em 8 s, para a página nunca ficar presa. -->
    <script is:inline>
      try {
        if (sessionStorage.getItem("giro:loaded") === null) {
          var html = document.documentElement;
          html.setAttribute("data-loader", "on");
          setTimeout(function () {
            if (html.getAttribute("data-loader") === "on") html.removeAttribute("data-loader");
          }, 8000);
        }
      } catch (e) { /* sessionStorage bloqueado: a página aparece direto */ }
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#2B2EFF" />
    <meta name="generator" content={Astro.generator} />
    <!-- Navegação sem recarregar a página (ADR 0002). Troca só o body; o head vem da página nova. -->
    <ClientRouter />

    <!-- Primary Meta Tags -->
    <title>{finalTitle}</title>
    <meta name="title" content={finalTitle} />
    <meta name="description" content={finalDesc} />

    <!-- Canonical URL (excluded on 404 and noindex pages) -->
    {!noindex && <link rel="canonical" href={canonicalURL} />}

    <!-- Robots -->
    {noindex || import.meta.env.VERCEL_ENV === 'preview' ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType || 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={finalTitle} />
    <meta property="og:description" content={finalDesc} />
    <meta property="og:image" content={finalImage} />
    {usesDefaultImage && <meta property="og:image:width" content="1200" />}
    {usesDefaultImage && <meta property="og:image:height" content="630" />}
    {usesDefaultImage && <meta property="og:image:alt" content={finalTitle} />}
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={siteConfig.seo.siteName} />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={finalTitle} />
    <meta property="twitter:description" content={finalDesc} />
    <meta property="twitter:image" content={finalImage} />

    <!-- Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet" />

    <!-- Performance/Analytics scripts base (como Plausible se houver) -->
    { import.meta.env.PROD && (
      <script defer data-domain="devguimaraes.com.br" src="https://plausible.io/js/script.js"></script>
    )}

    <!-- Client-side locale detection for lang/og attributes.
         O ClientRouter copia os atributos do <html> da página nova no swap (voltando para pt-BR),
         então o locale é reaplicado depois de cada navegação, não só no primeiro carregamento. -->
    <script>
      function applyLocale() {
        try {
          var locale = localStorage.getItem('locale') || 'pt';
          document.documentElement.lang = locale === 'en' ? 'en' : 'pt-BR';
          var ogLocale = document.querySelector('meta[property="og:locale"]');
          if (ogLocale) ogLocale.content = locale === 'en' ? 'en_US' : 'pt_BR';
        } catch(e) { /* localStorage pode não estar disponível (ambientes restritivos) */ }
      }
      applyLocale();
      document.addEventListener('astro:after-swap', applyLocale);
      document.addEventListener('astro:page-load', applyLocale);
    </script>
  </head>
  <body class="bg-black">
    <LoadingScreen client:load />
    <SiteHeader client:load />
    <main class="w-full relative">
      <slot />
    </main>
    <SiteFooter client:visible />
    <!-- Ilhas que sobrevivem à navegação (ilha de rolagem, barra de abas) entram aqui com
         transition:persist, para o ClientRouter manter a instância montada entre páginas. -->
    <ScrollIsland client:load transition:persist="scroll-island" transition:name="scroll-island" />
    <TabBar client:load transition:persist="tab-bar" transition:name="tab-bar" />
  </body>
</html>
